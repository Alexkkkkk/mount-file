[flake8]
max-line-length = 100
extend-ignore = E731,W503,E402
exclude = build,dist,.git,__pycache__,.venv,venv
per-file-ignores =
    # Re-export layer: these imports *are* the public API of the module.
    mountfile/qt_compat.py: F401
    # Qt names imported for symmetry with the other view modules.
    mountfile/hexview.py: F401
